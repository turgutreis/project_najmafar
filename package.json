{
  "name": "project-najmafar",
  "version": "1.0.0",
  "description": "Project Najmafar - A Cosmic Survival Game",
  "author": "Ali Mazlum <a_mazlum@web.de>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64",
    "build:all": "electron-builder --win --mac --linux --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.najmafar.game",
    "productName": "Project Najmafar",
    "files": [
      "index.html",
      "style.css",
      "game.js",
      "main.js",
      "universe_data.json",
      "assets/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Ali Mazlum <a_mazlum@web.de>"
    }
  }
}